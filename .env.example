# Variables del CLIENTE (Vite) — se incluyen en el bundle del navegador,
# por eso usan el prefijo VITE_. La anon key es pública por diseño.
VITE_SUPABASE_URL=https://rsknprqgadljxwkblwgc.supabase.co
VITE_SUPABASE_ANON_KEY=pega-aqui-tu-anon-public-key

# Variables del SERVIDOR (función serverless api/generar-contrato-pdf.ts)
# — NUNCA deben llevar el prefijo VITE_, o Vite las metería al bundle
# público. Configúralas en Vercel → Settings → Environment Variables,
# no hace falta ponerlas aquí para desarrollo local salvo que uses
# `vercel dev` (ver README).
SUPABASE_URL=https://rsknprqgadljxwkblwgc.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-tu-service-role-key
